image/ab67616d00001e024b509947e48d592bfd0d237b\"},{\"url\":\"https://i.scdn.co/image/ab67616d000048514b509947e48d592bfd0d237b\"},{\"url\":\"https://i.scdn.co/image/ab67616d0000b2734b509947e48d592bfd0d237b\"}]},\"uri\":\"spotify:album:5Mr8FpZP1DaLDxjbMD7GcR\"},\"artists\":{\"items\":[{\"profile\":{\"name\":\"Mariah Carey\"},\"uri\":\"spotify:artist:4iHNK0tOyZPYnBU7nGAgpQ\"}]},\"associationsV3\":{\"videoAssociations\":{\"totalCount\":1}},\"contentRating\":{\"label\":\"NONE\"},\"discNumber\":1,\"duration\":{\"totalMilliseconds\":215110},\"id\":\"0pkIJFV6mviH9dmBYsFwTM\",\"name\":\"Without You\",\"playability\":{\"playable\":true,\"reason\":\"PLAYABLE\"},\"playcount\":\"372396077\",\"uri\":\"spotify:track:0pkIJFV6mviH9dmBYsFwTM\"},\"uid\":\"d425f2edb1a4b56d3b44\"},{\"track\":{\"albumOfTrack\":{\"coverArt\":{\"sources\":[{\"url\":\"https://i.scdn.co/image/ab67616d00001e024b509947e48d592bfd0d237b\"},{\"url\":\"https://i.scdn.co/image/ab67616d000048514b509947e48d592bfd0d237b\"},{\"url\":\"https://i.scdn.co/image/ab67616d0000b2734b509947e48d592bfd0d237b\"}]},\"uri\":\"spotify:album:5Mr8FpZP1DaLDxjbMD7GcR\"},\"artists\":{\"items\":[{\"profile\":{\"name\":\"Mariah Carey\"},\"uri\":\"spotify:artist:4iHNK0tOyZPYnBU7nGAgpQ\"}]},\"associationsV3\":{\"videoAssociations\":{\"totalCount\":1}},\"contentRating\":{\"label\":\"NONE\"},\"discNumber\":1,\"duration\":{\"totalMilliseconds\":257921},\"id\":\"5mgCMlxQW7fmHbrdJuowbB\",\"name\":\"Hero\",\"playability\":{\"playable\":true,\"reason\":\"PLAYABLE\"},\"playcount\":\"370248508\",\"uri\":\"spotify:track:5mgCMlxQW7fmHbrdJuowbB\"},\"uid\":\"67166071e4782a3569cd\"}]}},\"goods\":{\"concerts\":{\"items\":[],\"totalCount\":0},\"merch\":{\"items\":[]}},\"headerImage\":{\"data\":{\"__typename\":\"ImageV2\",\"sources\":[{\"maxHeight\":640,\"maxWidth\":1494,\"url\":\"https://image-cdn-ak.spotifycdn.com/image/ab6761860000019498d45c67eb8c269b4f1adb42\"},{\"maxHeight\":1080,\"maxWidth\":1920,\"url\":\"https://i2o.scdn.co/image/ab6761860000166798d45c67eb8c269b4f1adb42\"},{\"maxHeight\":1080,\"maxWidth\":1920,\"url\":\"https://i2o.scdn.co/image/ab6761860000166798d45c67eb8c269b4f1adb42\"},{\"maxHeight\":641,\"maxWidth\":1495,\"url\":\"https://image-cdn-ak.spotifycdn.com/image/ab67618600009d8098d45c67eb8c269b4f1adb42\"},{\"maxHeight\":1140,\"maxWidth\":2660,\"url\":\"https://image-cdn-ak.spotifycdn.com/image/ab6761860000eab198d45c67eb8c269b4f1adb42\"}]}},\"id\":\"4iHNK0tOyZPYnBU7nGAgpQ\",\"onPlatformReputationTrait\":{\"verification\":{\"aiPersona\":null,\"isRegistered\":true,\"isVerified\":true}},\"preRelease\":null,\"profile\":{\"biography\":{\"text\":\"Mariah Carey is the best-selling female artist of all time with more than 200 million albums sold to date and 19 Billboard Hot 100 #1 singles (18 self-penned), more than any solo artist in history. \\nAn inductee to the Songwriters Hall of Fame, Carey is a singer/songwriter/producer recognized with multiple Grammy Awards, American Music Awards, three Guinness World Record titles, Billboard’s “Artist of the Decade” and “Icon Award,” the World Music Award for “World&#39;s Best Selling Female Artist of the Millennium,” the Ivor Novello Award for “PRS for Music Special International Award,” and BMI’s “Icon Award” for her outstanding achievements in songwriting, to name a few.\\nCarey’s ongoing impact has transcended the music industry. In 2009, Carey was recognized with the Breakthrough Performance Award at the Palm Spring International Film Festival for her critically acclaimed role in Lee Daniels’ “Precious.” Carey went on to appear in Daniels’ ensemble piece “The Butler” (2013). A Congressional Award recipient, Carey has generously donated her time and energy to a range of philanthropic causes near to her heart including Save the Music, the Make-A-Wish Foundation, World Hunger Relief, and the Elton John AIDS Foundation, among many others. A tremendous supporter of children’s charities, both domestic and international, Carey founded Camp Mariah in partnership with the Fresh Air Fund, a retreat for inner city children to explore career development.\",\"type\":\"AUTOBIOGRAPHY\"},\"externalLinks\":{\"items\":[{\"name\":\"FACEBOOK\",\"url\":\"https://facebook.com/mariahcarey\"},{\"name\":\"INSTAGRAM\",\"url\":\"https://instagram.com/mariahcarey\"},{\"name\":\"TIKTOK\",\"url\":\"https://tiktok.com/@mariahcarey\"},{\"name\":\"TWITTER\",\"url\":\"https://twitter.com/mariahcarey\"}]},\"name\":\"Mariah Carey\",\"pinnedItem\":{\"backgroundImageV2\":null,\"comment\":\"Glitter 25! ✨\",\"itemV2\":{\"__typename\":\"AlbumResponseWrapper\",\"data\":{\"__typename\":\"Album\",\"coverArt\":{\"sources\":[{\"height\":300,\"url\":\"https://i.scdn.co/image/ab67616d00001e02e23231cace412e5c2b89bb04\",\"width\":300},{\"height\":64,\"url\":\"https://i.scdn.co/image/ab67616d00004851e23231cace412e5c2b89bb04\",\"width\":64},{\"height\":640,\"url\":\"https://i.scdn.co/image/ab67616d0000b273e23231cace412e5c2b89bb04\",\"width\":640}]},\"name\":\"Didn't Mean To Turn You On (with Rochelle Jordan)\",\"preReleaseEndDateTime\":null,\"type\":\"SINGLE\",\"uri\":\"spotify:album:33Mfzj0B0jfExUap38bJYE\"}},\"subtitle\":\"Single • New Release\",\"thumbnailImage\":{\"data\":{\"sources\":[{\"url\":\"https://image-cdn-fa.spotifycdn.com/image/ab67616d000075a0e23231cace412e5c2b89bb04\"},{\"url\":\"https://image-cdn-fa.spotifycdn.com/image/ab67616d000090d5e23231cace412e5c2b89bb04\"},{\"url\":\"https://image-cdn-fa.spotifycdn.com/image/ab67616d0000ab87e23231cace412e5c2b89bb04\"}]}},\"title\":\"Didn't Mean To Turn You On (with Rochelle Jordan)\",\"type\":\"ALBUM\",\"uri\":\"spotify:album:33Mfzj0B0jfExUap38bJYE\"},\"playlistsV2\":{\"items\":[{\"data\":{\"__typename\":\"Playlist\",\"description\":\"Celebrating 30 years of Mariah Carey’s Daydream\",\"images\":{\"items\":[{\"sources\":[{\"height\":null,\"url\":\"https://image-cdn-fa.spotifycdn.com/image/ab67706c0000da8495e59376672cf8c71f8941a9\",\"width\":null}]}]},\"name\":\"Daydream - 30 Years \",\"ownerV2\":{\"data\":{\"__typ